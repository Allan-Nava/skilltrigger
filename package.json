{
  "name": "skilltrigger",
  "version": "0.0.3",
  "description": "How often a Claude Code skill's description makes the model load it, on prompts that should trigger it and near-misses that should not, measured behind gates that refuse to report a number they cannot trust.",
  "type": "module",
  "bin": {
    "skilltrigger": "bin/skilltrigger.mjs"
  },
  "files": [
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node bin/skilltrigger.mjs check && node --test",
    "backlog": "npx --yes backlogsync@0.1.0 check",
    "build:site": "node site/build.mjs",
    "roadmap": "npx --yes backlogsync@0.1.0 roadmap"
  },
  "backlogsync": {
    "prefix": "ST",
    "name": "skilltrigger",
    "regenerate": "npm run roadmap",
    "labels": {
      "gates": [
        "3b4bb8",
        "Preflight gates: CLI, auth, round trip, conflict, sleep, roster"
      ],
      "runner": [
        "0e8a16",
        "The serial runner and the stream detector"
      ],
      "report": [
        "fbca04",
        "Reports, verdict rule, compare"
      ],
      "release": [
        "5319e7",
        "Publishing and versioning"
      ],
      "docs": [
        "0075ca",
        "README, CONTRIBUTING, site"
      ],
      "project": [
        "6a737d",
        "Backlog, roadmap, repo hygiene"
      ],
      "tests": [
        "d4c5f9",
        "Test coverage and the fake claude"
      ],
      "enhancement": [
        "a2eeef",
        "New capability"
      ],
      "prio-med": [
        "e4b429",
        "Medium priority in BACKLOG.md"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allan-Nava/skilltrigger.git"
  },
  "homepage": "https://allan-nava.github.io/skilltrigger/",
  "bugs": "https://github.com/Allan-Nava/skilltrigger/issues",
  "keywords": [
    "claude-code",
    "skills",
    "evals",
    "trigger-rate",
    "skill-description",
    "measurement"
  ],
  "author": "Allan Nava (https://github.com/Allan-Nava)",
  "license": "MIT",
  "devDependencies": {
    "marked": "^17.0.0"
  }
}
